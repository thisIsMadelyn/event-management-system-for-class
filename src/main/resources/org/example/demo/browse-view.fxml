<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- W1 Browse events -->
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.demo.BrowseController"
      spacing="24" styleClass="screen">
    <padding>
        <Insets top="28" right="60" bottom="28" left="60"/>
    </padding>

    <Label text="Upcoming events" styleClass="screen-title"/>

    <HBox alignment="BOTTOM_LEFT" spacing="30">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Search events"/>
            <TextField fx:id="searchField" promptText="Search by title or keyword" styleClass="text-field,filter"
                       accessibleText="Search events" onAction="#onSearch"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Category"/>
            <ComboBox fx:id="categoryBox" prefWidth="220" styleClass="combo-box,filter" accessibleText="Category"/>
        </VBox>
        <VBox spacing="6">
            <Label text="Date"/>
            <ComboBox fx:id="dateBox" prefWidth="200" styleClass="combo-box,filter" accessibleText="Date"/>
        </VBox>
        <Button fx:id="searchButton" text="Search" minWidth="130" styleClass="button,primary,filter"
                onAction="#onSearch"/>
    </HBox>

    <ScrollPane fx:id="eventScroll" fitToWidth="true" hbarPolicy="NEVER" focusTraversable="false"
                styleClass="scroll-pane,event-scroll" VBox.vgrow="ALWAYS">
        <VBox fx:id="eventList" spacing="16"/>
    </ScrollPane>

    <VBox fx:id="emptyState" alignment="CENTER" spacing="6" visible="false" managed="false"
          minHeight="210" styleClass="empty-state">
        <Label text="No events match your search."/>
        <Label text="Clear the filters or check back later."/>
        <Button fx:id="clearButton" text="Clear filters" styleClass="button,primary" onAction="#onClear">
            <VBox.margin>
                <Insets top="30"/>
            </VBox.margin>
        </Button>
    </VBox>
</VBox>
