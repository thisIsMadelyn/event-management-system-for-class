<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- W1 Browse events -->
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.demo.BrowseController"
      spacing="12" styleClass="screen">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Browse events" styleClass="screen-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="myRegistrationsButton" text="My registrations" onAction="#onMyRegistrations"/>
    </HBox>
    <TextField fx:id="searchField" promptText="Search by title or location"/>
    <Label text="Click an event to see its details and register." styleClass="hint"/>
    <ListView fx:id="eventList" VBox.vgrow="ALWAYS"/>
</VBox>
