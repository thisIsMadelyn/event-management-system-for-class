<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<!-- W3 My registrations -->
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.demo.RegistrationsController"
      spacing="12" styleClass="screen">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <Label text="My registrations" styleClass="screen-title"/>
    <Label fx:id="feedbackLabel" styleClass="feedback,feedback-success"
           visible="false" managed="false" wrapText="true"/>
    <ListView fx:id="registrationList" VBox.vgrow="ALWAYS"/>
</VBox>
