<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!-- W2 Event details and registration -->
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.demo.DetailsController"
      spacing="12" styleClass="screen">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <Label fx:id="titleLabel" styleClass="screen-title"/>
    <VBox spacing="4" styleClass="event-details">
        <Label fx:id="dateLabel"/>
        <Label fx:id="locationLabel"/>
        <Label fx:id="seatsLabel"/>
    </VBox>
    <Label fx:id="descriptionLabel" wrapText="true"/>

    <Separator/>

    <Label text="Register" styleClass="section-title"/>
    <VBox fx:id="form" spacing="6" maxWidth="420">
        <Label text="Full name" labelFor="$fullNameField"/>
        <TextField fx:id="fullNameField"/>
        <Label fx:id="fullNameError" styleClass="field-error" visible="false" managed="false" wrapText="true"/>

        <Label text="Email" labelFor="$emailField"/>
        <TextField fx:id="emailField" promptText="name@example.com"/>
        <Label fx:id="emailError" styleClass="field-error" visible="false" managed="false" wrapText="true"/>

        <Label text="Phone" labelFor="$phoneField"/>
        <TextField fx:id="phoneField"/>
        <Label fx:id="phoneError" styleClass="field-error" visible="false" managed="false" wrapText="true"/>

        <Button fx:id="registerButton" text="Register" defaultButton="true" onAction="#onRegister">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
        </Button>
    </VBox>

    <Label fx:id="feedbackLabel" styleClass="feedback" visible="false" managed="false" wrapText="true"/>
</VBox>
