<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- W2 Event details and registration. Scrolls when the window is small. -->
<ScrollPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.demo.DetailsController"
            fitToWidth="true" focusTraversable="false" styleClass="scroll-pane,event-scroll">
    <HBox spacing="60" alignment="TOP_LEFT">
        <padding>
            <Insets top="18" right="60" bottom="28" left="60"/>
        </padding>

        <!-- Event details -->
        <VBox spacing="12" minWidth="240" prefWidth="520" HBox.hgrow="ALWAYS">
            <Button fx:id="backButton" text="&lt; Back to Browse Events" styleClass="button,back-link"
                    onAction="#onBack"/>
            <Label fx:id="titleLabel" wrapText="true" styleClass="screen-title">
                <VBox.margin>
                    <Insets top="12"/>
                </VBox.margin>
            </Label>
            <Label fx:id="categoryLabel" styleClass="category-tag"/>
            <VBox spacing="6">
                <Label fx:id="dateLabel" wrapText="true"/>
                <Label fx:id="locationLabel" wrapText="true"/>
                <Label fx:id="spacesLabel" wrapText="true"/>
            </VBox>
            <Label text="About this event" styleClass="section-heading">
                <VBox.margin>
                    <Insets top="16"/>
                </VBox.margin>
            </Label>
            <Label fx:id="descriptionLabel" wrapText="true" maxWidth="Infinity" styleClass="description-box"/>
        </VBox>

        <!-- Registration form -->
        <VBox spacing="10" minWidth="360" prefWidth="580" HBox.hgrow="ALWAYS" styleClass="form-card">
            <Label text="Register for this event" styleClass="screen-title"/>
            <Label text="* Required field" styleClass="hint"/>
            <Label fx:id="feedbackLabel" styleClass="feedback,feedback-error" maxWidth="Infinity"
                   visible="false" managed="false" wrapText="true"/>

            <VBox fx:id="form" spacing="6">
                <Label text="Full name *" styleClass="field-label"/>
                <TextField fx:id="fullNameField" styleClass="text-field,form-field"
                           accessibleText="Full name, required"/>
                <Label fx:id="fullNameError" styleClass="field-error" visible="false" managed="false" wrapText="true"/>

                <Label text="Email address *" styleClass="field-label"/>
                <TextField fx:id="emailField" styleClass="text-field,form-field"
                           accessibleText="Email address, required"/>
                <Label fx:id="emailError" styleClass="field-error" visible="false" managed="false" wrapText="true"/>

                <Label text="Number of places *" styleClass="field-label"/>
                <ComboBox fx:id="placesBox" prefWidth="240" styleClass="combo-box,form-field"
                          accessibleText="Number of places, required"/>
                <Label fx:id="placesError" styleClass="field-error" visible="false" managed="false" wrapText="true"/>

                <Label text="Dietary or access needs (optional)" styleClass="field-label"/>
                <TextArea fx:id="needsArea" prefRowCount="3" wrapText="true"
                          accessibleText="Dietary or access needs, optional"/>
            </VBox>

            <HBox spacing="20">
                <VBox.margin>
                    <Insets top="14"/>
                </VBox.margin>
                <Button fx:id="confirmButton" text="Confirm registration" defaultButton="true"
                        styleClass="button,primary,form-button" onAction="#onConfirm"/>
                <Button fx:id="cancelButton" text="Cancel" styleClass="button,secondary,form-button"
                        onAction="#onBack"/>
            </HBox>
        </VBox>
    </HBox>
</ScrollPane>
